# ==============================================================================
# HIMAL SANKET ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM ENGINE
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for live Gemini AI chat & multi-hazard briefings.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: URL where this applet is hosted (optional in local dev).
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM (SEPARATE SERVICE KEYS)
# ------------------------------------------------------------------------------
# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key (client-side map tiles).
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_GEOCODING_API_KEY / GOOGLE_GEOCODING_API_KEY: Dedicated Geocoding key.
# (Falls back to VITE_GOOGLE_MAPS_API_KEY if left blank)
VITE_GOOGLE_GEOCODING_API_KEY=""
GOOGLE_GEOCODING_API_KEY=""

# VITE_GOOGLE_ELEVATION_API_KEY / GOOGLE_ELEVATION_API_KEY: Dedicated Elevation key.
# (Falls back to VITE_GOOGLE_MAPS_API_KEY if left blank)
VITE_GOOGLE_ELEVATION_API_KEY=""
GOOGLE_ELEVATION_API_KEY=""

# VITE_GOOGLE_PLACES_API_KEY / GOOGLE_PLACES_API_KEY: Dedicated Places API key.
# (Falls back to VITE_GOOGLE_MAPS_API_KEY if left blank)
VITE_GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# ------------------------------------------------------------------------------
# 3. BACKEND MULTI-HAZARD RISK ENGINE
# ------------------------------------------------------------------------------
VITE_RISK_ENGINE_API="http://localhost:8000"
